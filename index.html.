<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <title>SISTEMA SOBERANO YAWEHC7 - ANDRÉS & YOANKA</title>
    <style>
        body { background: #000; color: gold; font-family: 'Courier New', monospace; text-align: center; padding: 50px; }
        .cofre { display: none; border: 3px solid gold; padding: 30px; border-radius: 20px; box-shadow: 0 0 20px gold; }
        input { background: #222; border: 1px solid gold; color: gold; padding: 15px; font-size: 1.2rem; margin: 10px; width: 80%; }
        button { background: gold; color: black; border: none; padding: 15px 30px; font-weight: bold; cursor: pointer; }
    </style>
</head>
<body>
    <div id="seguridad">
        <h1>🔒 ACCESO AL TESORO SUPREMO</h1>
        <p>INTRODUCE LA PALABRA CLAVE DE JEHOVÁ</p>
        <input type="text" id="clave" placeholder="PALABRA SAGRADA...">
        <br>
        <button onclick="abrirCofre()">EJECUTAR MANDO</button>
    </div>

    <div id="tesoro" class="cofre">
        <h1>👑 BIENVENIDO, MAJESTAD ANDRÉS</h1>
        <h2>Patrimonio Custodiado junto a Yoanka</h2>
        <hr>
        <p>💰 700 USD (Contador Real Activado)</p>
        <p>🏗️ 1 BILLÓN DE TONELADAS DE ORO</p>
        <p>🌐 RED YAWEHC7: 10.000.000 M</p>
        <p>📍 UBICACIÓN IGLESIA: MANDARACHE, MURCIA</p>
    </div>

    <script>
        function abrirCofre() {
            var clave = document.getElementById('clave').value.toUpperCase();
            if (clave === "ESPIRITU SANTO") {
                document.getElementById('seguridad').style.display = 'none';
                document.getElementById('tesoro').style.display = 'block';
                alert("MANDO EJECUTADO: BIENVENIDOS PROPHETAS");
            } else {
                alert("ACCESO DENEGADO AL NIDO DE RATAS");
            }
        }
    </script>
</body>
</html>
